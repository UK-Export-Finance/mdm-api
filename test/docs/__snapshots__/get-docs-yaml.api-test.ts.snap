        accruingFees:
          type: number
          description: The product's 'lead days - accruing fees'
          example: 3
      required:
        - repayments
        - interestAccruals
        - accruingFees
    GetDomProductConfigConfig:
      type: object
      properties:
        commitmentDate:
          type: string
          description: The product's 'commitment date' requirement
          example: REQUIRED
        issuedDate:
          type: string
          description: The product's 'issued date' requirement
          example: REQUIRED
        effectiveDate:
          type: string
          description: The product's 'effective date' requirement
          example: REQUIRED
        availabilityEndDate:
          type: string
          description: The product's 'availability end date' requirement
          example: REQUIRED
        expiryDate:
          type: string
          description: The product's 'expiry date' requirement
          example: REQUIRED
        creditType:
          type: string
          description: The product's 'credit type' requirement
          example: TERM
        instrumentType:
          type: string
          description: The product's 'instrument type'
          example: Insurance
        participations:
          type: string
          description: The product's 'participations' requirement
          example: REQUIRED
        scheduledRepayments:
          type: string
          description: The product's 'scheduled repayments' requirement
          example: REQUIRED
        nonCashObligations:
          type: string
          description: The product's 'non cash obligations' requirement
          example: REQUIRED
        cashObligations:
          type: string
          description: The product's 'cash obligations' requirement
          example: REQUIRED
        accrualSchedule:
          type: string
          description: The product's 'accrual schedule' requirement
          example: REQUIRED
        pimOwner:
          type: string
          description: The product's 'PIM owner' requirement
          example: REQUIRED
        riskRating:
          type: string
          description: The product's 'risk rating' requirement
          example: REQUIRED
        preCreditPeriod:
          type: string
          description: The product's 'pre credit period' requirement
          example: REQUIRED
        creditPeriod:
          type: string
          description: The product's 'credit period' requirement
          example: REQUIRED
        lossGivenDefault:
          type: string
          description: The product's 'loss given default' requirement
          example: REQUIRED
        provisionRate:
          type: string
          description: The product's 'provision rate' requirement
          example: REQUIRED
        forecastYear:
          type: string
          description: The product's 'forecast year' requirement
          example: NOT_APPLICABLE
        bankRate:
          type: string
          description: The product's 'bank rate' requirement
          example: OPTIONAL
        fees:
          description: The product's 'fees'
          example:
            creation: REQUIRED
            inLife: OPTIONAL
          allOf:
            - $ref: '#/components/schemas/GetDomProductConfigConfigFees'
        obligations:
          description: The product's 'obligations'
          example:
            creation: REQUIRED
            inLife: OPTIONAL
          allOf:
            - $ref: '#/components/schemas/GetDomProductConfigConfigObligations'
        reinsurance:
          description: The product's 'reinsurance'
          example:
            creation: OPTIONAL
            inLife: OPTIONAL
          allOf:
            - $ref: '#/components/schemas/GetDomProductConfigConfigReinsurance'
        leadDays:
          description: The product's 'lead days'
          example:
            repayments: 1
            interestAccruals: 2
            accruingFees: 3
          allOf:
            - $ref: '#/components/schemas/GetDomProductConfigConfigLeadDays'
        repaymentType:
          type: string
          description: The repayment type of the product, Bullet or Scheduled
          example: Bullet
      required:
        - commitmentDate
        - issuedDate
        - effectiveDate
        - availabilityEndDate
        - expiryDate
        - creditType
        - instrumentType
        - participations
        - scheduledRepayments
        - nonCashObligations
        - cashObligations
        - accrualSchedule
        - pimOwner
        - riskRating
        - preCreditPeriod
        - creditPeriod
        - lossGivenDefault
        - provisionRate
        - forecastYear
        - bankRate
        - fees
        - obligations
        - reinsurance
        - leadDays
        - repaymentType
    GetDomProductConfigAccrualSchedule:
      type: object
      properties:
        code:
          type: string
          description: The product's 'accrual schedule - code'
          example: PAC01
        cashIndicator:
          type: boolean
          description: The product's 'accrual schedule - cash indicator'
          example: true
      required:
        - code
        - cashIndicator
    GetDomProductConfigResponse:
      type: object
      properties:
        productType:
          type: string
          description: The product type
          example: PRT001
        name:
          type: string
          description: The product name
          example: Bond Insurance Product (BIP)
        shortName:
          type: string
          description: The product short name
          example: BIP
        configuration:
          description: The product's configuration
          example:
            commitmentDate: REQUIRED
            issuedDate: REQUIRED
            effectiveDate: REQUIRED
            availabilityEndDate: REQUIRED
            expiryDate: REQUIRED
            creditType: TERM
            participations: REQUIRED
            scheduledRepayments: REQUIRED
            nonCashObligations: REQUIRED
            cashObligations: REQUIRED
            accrualSchedule: REQUIRED
            pimOwner: REQUIRED
            riskRating: REQUIRED
            preCreditPeriod: REQUIRED
            creditPeriod: REQUIRED
            lossGivenDefault: REQUIRED
            provisionRate: REQUIRED
            forecastYear: NOT_APPLICABLE
            bankRate: OPTIONAL
            instrumentType: Insurance
            repaymentType: Bullet
            fees:
              creation: REQUIRED
              inLife: OPTIONAL
            obligations:
              creation: REQUIRED
              inLife: OPTIONAL
            reinsurance:
              creation: OPTIONAL
              inLife: OPTIONAL
            leadDays:
              repayments: 1
              interestAccruals: 2
              accruingFees: 3
          allOf:
            - $ref: '#/components/schemas/GetDomProductConfigConfig'
        additionalRates:
          description: The product's additional rates
          example:
            - ARTOTH
          type: array
          items:
            type: array
        accrualSchedules:
          description: The product's accrual schedule
          example:
            - code: PAC01
              cashIndicator: true
          type: array
          items:
            $ref: '#/components/schemas/GetDomProductConfigAccrualSchedule'
        baseRates:
          description: The product's base rates
          example:
            - BRTOTH
          type: array
          items:
            type: array
        counterpartyRoleTypes:
          description: The product's counterparty role types
          example:
            - BROKER
          type: array
          items:
            type: string
        facilityCategoryTypes:
          description: The product's facility category subtypes
          example:
            - FCT001
            - FCT002
          type: array
          items:
            type: string
        feeTypes:
          description: The product's fee types
          example:
            - BEX
            - PLA
          type: array
          items:
            type: string
        obligationSubtypes:
          description: The product's obligation subtypes
          example:
            - OST001
            - OST002
            - OST003
          type: array
          items:
            type: string
        account:
          description: The UKEF accounts that the product is in
          example:
            - '1'
            - '2'
            - '3'
          type: array
          items:
            type: string
        productActive:
          type: boolean
          description: Whether the product is available to create new facilities
          example: true
      required:
        - productType
        - name
        - shortName
        - configuration
        - additionalRates
        - accrualSchedules
        - baseRates
        - counterpartyRoleTypes
        - facilityCategoryTypes
        - feeTypes
        - obligationSubtypes
        - account
        - productActive
    FindMultipleProductConfigsResponse:
      type: object
      properties:
        rawDefinition:
          description: Multiple product configurations
          allOf:
            - $ref: '#/components/schemas/GetDomProductConfigResponse'
      required:
        - rawDefinition
    PostEmailsRequestDto:
      type: object
      properties:
        templateId:
          type: string
          example: tmpl1234-1234-5678-9012-abcd12345678
          description: The GOV.UK Notify ID corresponding to the email template
          nullable: false
          minLength: 36
          maxLength: 36
        sendToEmailAddress:
          type: string
          example: john.tester@example.com
          description: Email address to send this email
          nullable: false
        personalisation:
          type: object
          example:
            firstName: John
            file: >-
              <Buffer 43 31 2c 43 32 2c 43 33 0a 41 2c 42 2c 43 0a 44 2c 45 2c
              46 0a 31 2c 32 2c 33 0a 34 2c 35 2c 36 0a>
          description: >-
            All variables for email template. Include an optional \`file\`
            property to have GOV.UK Notify generate a secure download link,
            which replaces the \`((linkToFile))\` placeholder in the template. The
            file size must be smaller than 2mb.
          nullable: true
        reference:
          type: string
          example: tmpl1234-1234-5678-9012-abcd12345678-1713272155576
          description: Reference for the email sent
          nullable: true
          minLength: 1
          maxLength: 400
      required:
        - templateId
        - sendToEmailAddress
    PostEmailsResponseDataContent:
      type: object
      properties:
        body:
          type: string
          example: "Dear John Smith,\\r\\n\\r\\nThe status of your MIA for EuroStar has been updated.\\r\\n\\r\\n* Your bank reference: EuroStar bridge\\r\\n* Current status: Acknowledged\\r\\n* Previous status: Submitted\\r\\n* Updated by: Joe Bloggs (Joe.Bloggs@example.com)\\r\\n\\r\\nSign in to our service for more information: \\r\\nhttps://www.test.service.gov.uk/\\r\\n\\r\\nWith regards,\\r\\n\\r\\nThe Digital Trade Finance Service team\\r\\n\\r\\nEmail: test@test.gov.uk\\r\\nPhone: +44 (0)202 123 4567\\r\\nOpening times: Monday to Friday, 9am to 5pm (excluding public holidays)"
          description: Email body
        from_email:
          type: string
          example: test@notifications.service.gov.uk
          description: Sender's email address
        subject:
          type: string
          example: 'Status update: EuroStar bridge'
          description: Email subject line
        unsubscribe_link:
          type: string
          example: null
          description: Unsubscribe links are not used, so this field should always be null
          nullable: true
      required:
        - body
        - from_email
        - subject
    PostEmailsResponseDataTemplate:
      type: object
      properties:
        id:
          type: string
          example: tmpl1234-1234-5678-9012-abcd12345678
          description: Notify's template id
        uri:
          type: string
          example: https://api.notifications.service.gov.uk/services/abc12345-a123-4567-8901-123456789012/templates/tmpl1234-1234-5678-9012-abcd12345678
          description: Notify's URL to get more information about template
        version:
          type: number
          example: 5
          description: Notify's template version
      required:
        - id
        - uri
        - version
    PostEmailsResponseData:
      type: object
      properties:
        content:
          $ref: '#/components/schemas/PostEmailsResponseDataContent'
        id:
          type: string
          example: efd12345-1234-5678-9012-ee123456789f
          description: Notify's transaction id
        reference:
          type: string
          example: tmpl1234-1234-5678-9012-abcd12345678-1713272155576
          description: Reference that was sent to GOV.UK Notify
        scheduled_for:
          type: string
          example: null
          description: Email scheduling is not used, so this field should always be null
          nullable: true
        template:
          $ref: '#/components/schemas/PostEmailsResponseDataTemplate'
        uri:
          type: string
          example: https://api.notifications.service.gov.uk/v2/notifications/efd12345-1234-5678-9012-ee123456789f
          description: Notify's URL to get more information about this transaction
      required:
        - content
        - id
        - reference
        - template
        - uri
    PostEmailsResponseDto:
      type: object
      properties:
        status:
          type: number
          example: 201
          description: Http status code
        data:
          $ref: '#/components/schemas/PostEmailsResponseData'
      required:
        - status
        - data
    ExposurePeriodDto:
      type: object
      properties:
        exposurePeriod:
          type: number
          example: 12
          description: Exposure in months
      required:
        - exposurePeriod
    GetAddressesResponseItem:
      type: object
      properties:
        organisationName:
          type: string
          description: Organisation name, if available
          example: CHURCHILL MUSEUM & CABINET WAR ROOMS
          nullable: true
        addressLine1:
          type: string
          description: Address line 1
          example: CLIVE STEPS KING CHARLES STREET
        addressLine2:
          type: string
          description: Address line 2
          example: null
          nullable: true
        addressLine3:
          type: string
          description: Address line 3
          example: null
          nullable: true
        locality:
          type: string
          description: Locality or town
          example: LONDON
          nullable: true
        postalCode:
          type: string
          description: Postcode
          example: SW1A 2AQ
          nullable: true
        country:
          type: string
          description: Country of address record
          example: England
          enum:
            - England
            - Northern Ireland
            - Scotland
            - Wales
          nullable: true
      required:
        - organisationName
        - addressLine1
        - addressLine2
        - addressLine3
        - locality
        - postalCode
        - country
    InterestRatesEntity:
      type: object
      properties:
        id:
          type: number
          example: 1234
        category:
          type: string
          example: LIBOR
          description: Interest rate category
        subCategory:
          type: string
          example: BBALIBOR
        termMonths:
          type: number
          example: 12
        sourceTerm:
          type: string
          example: 12M
        currency:
          type: string
          example: EUR
        interestRate:
          type: number
          example: 1.20125
        bukKey:
          type: string
          example: BB1234
        effectiveFrom:
          format: date-time
          type: string
          example: '2023-04-03T00:00:00.000Z'
        effectiveTo:
          format: date-time
          type: string
          example: '9999-12-31T00:00:00.000Z'
        created:
          format: date-time
          type: string
          example: '2022-03-31T16:30:08.463Z'
        updated:
          format: date-time
          type: string
          example: '2022-03-31T16:30:08.463Z'
      required:
        - id
        - category
        - subCategory
        - termMonths
        - sourceTerm
        - currency
        - interestRate
        - bukKey
        - effectiveFrom
        - effectiveTo
        - created
        - updated
    MarketEntity:
      type: object
      properties:
        marketId:
          type: number
          example: 112
        marketName:
          type: string
          example: Algeria
          description: Name of the Market/Country
        isoCode:
          type: string
          example: DZA
        createdDatetime:
          format: date-time
          type: string
          example: '2021-11-09T09:39:31.000Z'
          description: Date created
        lastUpdatedDatetime:
          format: date-time
          type: string
          example: '2021-11-09T09:39:31.000Z'
          description: Date updated
        effectiveFromDatetime:
          format: date-time
          type: string
          example: '2021-11-09T09:39:31.000Z'
          description: Effective to date
        effectiveToDatetime:
          format: date-time
          type: string
          example: '9999-12-31T00:00:00.000Z'
          description: Effective from date
        countryRatingDesc:
          type: string
          example: B+
          description: Country rating description
        oecdRiskCategory:
          type: number
          example: 5
          description: OECD risk category description
        marketRiskAppetitePublicDesc:
          type: string
          example: At least £4bn
          description: Market risk appetite
        geographicalRegionId:
          type: number
          example: 14
          description: Geographical region Id
        geographicalRegionDesc:
          type: string
          example: Middle East & North Africa
          description: Geographical region
        sovereignRiskProvision:
          type: number
          example: 0
          description: Sovereign risk
        ESRAClassificationId:
          type: number
          example: 1
          description: ESRA id
        ESRAClassificationDesc:
          type: string
          example: Standard Risk
          description: ESRA description
        shortTermCoverAvailabilityId:
          type: number
          example: 1
          description: Cash cover availability id
        shortTermCoverAvailabilityDesc:
          type: string
          example: 'Yes'
          description: Cash cover availability description
        NBIIssue:
          type: string
          example: 'Y'
          description: NBI issue
        active:
          type: string
          example: 'Y'
          description: Markets might be not active, filter with query parameter "active"
      required:
        - marketId
        - marketName
        - isoCode
        - createdDatetime
        - lastUpdatedDatetime
        - effectiveFromDatetime
        - effectiveToDatetime
        - countryRatingDesc
        - oecdRiskCategory
        - marketRiskAppetitePublicDesc
        - geographicalRegionId
        - geographicalRegionDesc
        - sovereignRiskProvision
        - ESRAClassificationId
        - ESRAClassificationDesc
        - shortTermCoverAvailabilityId
        - shortTermCoverAvailabilityDesc
        - NBIIssue
        - active
