      properties:
        urn:
          type: string
          description: Unique UKEF customer ID
          example: '00312345'
        name:
          type: string
          description: Customer name
          example: Test Company name
      required:
        - urn
        - name
    GetOdsDealResponse:
      type: object
      properties:
        dealId:
          type: string
          description: Unique UKEF deal ID
          example: '0030000321'
        name:
          type: string
          description: Deal name
          example: ABC PARIS CLUB 01
        description:
          type: string
          description: Deal description
          example: Paris Club agreement
      required:
        - dealId
        - name
        - description
    GetFacilityCategoryResponseDto:
      type: object
      properties:
        type:
          type: string
          description: Facility classification type
          example: Facility Category
        typeCode:
          type: string
          description: Facility classification type code
          example: facilityCategory
        code:
          type: string
          description: Facility classification code
          example: FCT006
        description:
          type: string
          description: Facility classification description
          example: 'GEF: Contingent'
        isActive:
          type: boolean
          description: Facility classification active flag
          example: true
      required:
        - type
        - typeCode
        - code
        - description
        - isActive
    GetFeeTypeResponseDto:
      type: object
      properties:
        feeType:
          type: string
          description: Fee type code
          example: CMF
        name:
          type: string
          description: Fee type name
          example: Commitment Fee
        classification:
          type: string
          description: Fee type classification
          example: Accruing
        expenseIncome:
          type: string
          description: Fee type expense/income
          example: Income
        isActive:
          type: boolean
          description: Fee type active flag
          example: true
        balanceCategory:
          type: string
          description: Balance category
          example: CMF
          nullable: true
        baseBalanceCategory:
          type: string
          description: Base balance category
          example: On facility available amount
          nullable: true
        nonFacilityCurrencySettlement:
          type: boolean
          description: Non-facility currency settlement flag
          example: false
        cappedBaseBalance:
          type: boolean
          description: If the base balance upon which the fee accrues should be capped
          example: false
        effectiveDateDefault:
          type: string
          description: >-
            What the effective date of the fee should default to if not
            specified
          example: Facility Signed Date
          nullable: true
        maturityDateDefault:
          type: string
          description: What the maturity date of the fee should default to if not specified
          example: Facility Availability End Date
          nullable: true
      required:
        - feeType
        - name
        - classification
        - expenseIncome
        - isActive
        - balanceCategory
        - baseBalanceCategory
        - nonFacilityCurrencySettlement
        - cappedBaseBalance
        - effectiveDateDefault
        - maturityDateDefault
    GetObligationSubtypeResponseDto:
      type: object
      properties:
        code:
          type: string
          description: Obligation subtype code
          example: OST012
        description:
          type: string
          description: Obligation subtype description
          example: BSS Advance Payment Guarantee
        balanceCategory:
          type: string
          description: Obligation subtype balance category
          example: PRIN1
        isActive:
          type: boolean
          description: Obligation subtype active flag
          example: true
      required:
        - code
        - description
        - balanceCategory
        - isActive
    ObligationSubtypeWithProductTypeDto:
      type: object
      properties:
        code:
          type: string
          description: Obligation subtype code
          example: OST012
        description:
          type: string
          description: Obligation subtype description
          example: BSS Advance Payment Guarantee
        balanceCategory:
          type: string
          description: Obligation subtype balance category
          example: PRIN1
        isActive:
          type: boolean
          description: Obligation subtype active flag
          example: true
        productTypeCode:
          type: string
          description: The product type code
          example: PRT001
      required:
        - code
        - description
        - balanceCategory
        - isActive
        - productTypeCode
    GetIndustryResponseDto:
      type: object
      properties:
        id:
          type: string
          description: Industry ID
          example: UKEF_1908
        code:
          type: string
          description: Industry code
          example: '1908'
        description:
          type: string
          description: Industry description
          example: 'MINING & METALS : MISCELLANEOUS'
        groupCode:
          type: string
          description: Industry group code
          example: '19'
        groupDescription:
          type: string
          description: Industry group description
          example: 'CIVIL: MINING & METALS'
        category:
          type: string
          description: Industry category
          example: UKEF
      required:
        - id
        - code
        - description
        - groupCode
        - groupDescription
        - category
    GetSicCodeToUkefIndustryResponseDto:
      type: object
      properties:
        ukefIndustryCode:
          type: string
          description: UKEF industry code
          example: '1908'
      required:
        - ukefIndustryCode
    CreatePremiumScheduleDto:
      type: object
      properties:
        facilityURN:
          type: number
          example: 30000425
          description: >-
            UKEF ID for Facility, but without 00 at beginning. Usually UKEF ID
            is string, but in this endpoint it is number
        productGroup:
          type: string
          example: BS
          description: 'Two products are accepted: EW and BS'
        premiumTypeId:
          type: number
          example: 1
          description: >-
            Premium type concerns how we are being paid. It can be: 1 -> In
            advance, 2 -> In Arrears or 3-> At Maturity.
        premiumFrequencyId:
          type: number
          example: 1
          description: >-
            Payment frequency. It can be: 0 -> Null (At maturity), 1 -> Monthly,
            2 -> Quarterly, 3-> Semi-annually or 4 -> Annually
        guaranteeCommencementDate:
          format: date-time
          type: string
          example: '2021-01-19'
          description: Start date
        guaranteeExpiryDate:
          format: date-time
          type: string
          example: '2022-05-17'
          description: End date
        guaranteePercentage:
          type: number
          example: 80
          description: >-
            Percentage covered, expecting whole number i.e. if 90% expecting the
            number 90
        guaranteeFeePercentage:
          type: number
          example: 1.35
          description: >-
            UKEF Fee percentage, expecting whole number i.e. if 90% expecting
            the number 90
        dayBasis:
          type: string
          example: '360'
          description: 360 or 365. UK or US calendar
        exposurePeriod:
          type: number
          example: 16
          description: >-
            How many periods are we exposed to the risk, This is pre-calculated
            in the Exposure Period Calc
        cumulativeAmount:
          type: number
          example: null
          description: >-
            Optional EWCS Exposure ONLY, this is the cumulative amount drawn on
            the first disbursement. NULL if not EWCS
        maximumLiability:
          type: number
          example: 40000
          description: Required for BS Exposure
      required:
        - facilityURN
        - productGroup
        - premiumTypeId
        - premiumFrequencyId
        - guaranteeCommencementDate
        - guaranteeExpiryDate
        - guaranteePercentage
        - guaranteeFeePercentage
        - dayBasis
        - exposurePeriod
        - maximumLiability
    PremiumScheduleEntity:
      type: object
      properties:
        facilityURN:
          type: string
          example: '30000425'
          description: UKEF ID for Facility, but without 00 at beginning
        calculationDate:
          format: date-time
          type: string
          example: '2023-02-27'
        income:
          type: number
          example: 465
        incomePerDay:
          type: number
          example: 15
        exposure:
          type: number
          example: 400000
        period:
          type: number
          example: 1
        daysInPeriod:
          type: number
          example: 31
        effectiveFrom:
          format: date-time
          type: string
          example: '2023-02-27T00:00:00.000Z'
        effectiveTo:
          type: string
          example: '2023-02-27T00:00:00.000Z'
        created:
          format: date-time
          type: string
          example: '2023-02-27T00:00:00.000Z'
        updated:
          format: date-time
          type: string
          example: '2023-02-27T00:00:00.000Z'
        isActive:
          type: string
          example: 'Y'
          description: >-
            Can be Y or N. Not active records are just for record tracking. Just
            active records will be returned.
      required:
        - facilityURN
        - calculationDate
        - income
        - incomePerDay
        - exposure
        - period
        - daysInPeriod
        - effectiveFrom
        - effectiveTo
        - created
        - updated
        - isActive
    YieldRateEntity:
      type: object
      properties:
        shortName:
          type: string
          example: EUR SWAP (ESTR) 3Y
        pxBidPrice:
          type: number
          example: 3.4594
        pxAskPrice:
          type: number
          example: 3.4706
        pxLastPrice:
          type: number
          example: 3.465
        pxMidPrice:
          type: number
          example: 3.465
        futureMonthYear:
          type: string
          example: "      "
        sourceErrorCode:
          type: number
          example: 0
        sourceUpdateTimestamp:
          type: string
          example: '16:01:08'
        yieldIndex:
          type: string
          example: EESWE3 Curncy
        created:
          format: date-time
          type: string
          example: 2023-02-27T16:29:12.93.027Z
        updated:
          format: date-time
          type: string
          example: 2023-02-27T16:29:12.93.027Z
        effectiveTo:
          format: date-time
          type: string
          example: '9999-12-31T00:00:00.000Z'
        effectiveFrom:
          format: date-time
          type: string
          example: '2023-02-27T00:00:00.000Z'
      required:
        - shortName
        - pxBidPrice
        - pxAskPrice
        - pxLastPrice
        - pxMidPrice
        - futureMonthYear
        - sourceErrorCode
        - sourceUpdateTimestamp
        - yieldIndex
        - created
        - updated
        - effectiveTo
        - effectiveFrom
security:
  - ApiKeyHeader: []
"
`;
