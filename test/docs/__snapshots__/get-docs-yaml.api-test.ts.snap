// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`GET /openapi/yaml matches the snapshot 1`] = `
"openapi: 3.0.0
paths:
  /api/v1/companies:
    get:
      operationId: CompaniesController_getCompanyByRegistrationNumber_v1
      parameters:
        - name: registrationNumber
          required: true
          in: query
          description: The Companies House registration number of the company to find.
          schema:
            minLength: 8
            maxLength: 8
            pattern: ^(([A-Z]{2}|[A-Z]\\d|\\d{2})(\\d{6}|\\d{5}[A-Z]))$
            example: '00000001'
            type: string
      responses:
        '200':
          description: >-
            Returns the company matching the Companies House registration
            number.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/GetCompanyResponse'
        '400':
          description: Invalid Companies House registration number.
        '404':
          description: Company not found.
        '422':
          description: >-
            Company is an overseas company. UKEF can only process applications
            from companies based in the UK.
        '500':
          description: Internal server error.
      summary: Get company by Companies House registration number
      tags:
        - companies
  /api/v1/sector-industries:
    get:
      operationId: SectorIndustriesController_find_v1
      parameters:
        - name: ukefSectorId
          required: false
          in: query
          description: Search by UKEF Sector id, returns multiple Industries
          schema:
            example: '1010'
            type: string
        - name: ukefIndustryId
          required: false
          in: query
          description: Search by UKEF Industry id, most likely returns 1 result
          schema:
            example: '02400'
            type: string
      responses:
        '200':
          description: UKEF sectors/industries
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/SectorIndustryEntity'
      summary: Get UKEF sectors/industries mapping To ACBS sectors/industries
      tags:
        - sector-industries
  /api/v1/currencies:
    get:
      operationId: CurrenciesController_findAll_v1
      parameters: []
      responses:
        '200':
          description: All currencies
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/CurrencyEntity'
      summary: Get all currencies
      tags:
        - currencies
  /api/v1/currencies/exchange:
    get:
      operationId: CurrenciesController_findExchangeRate_v1
      parameters:
        - name: source
          required: true
          in: query
          description: >-
            Source currency for exchange rate - Use ISO 3 alpha currency code
            standard. Only GBP and USD currencies are supported
          schema:
            example: GBP
            type: string
        - name: target
          required: true
          in: query
          description: >-
            Target currency for exchange rate - Use ISO 3 alpha currency code
            standard
          schema:
            example: AED
            type: string
        - name: exchangeRateDate
          required: false
          in: query
          description: Retrieve the exchange rate for a specific date
          schema:
            example: '2021-01-26'
            type: string
      responses:
        '200':
          description: Active exchange rate
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/GetCurrencyExchangeDto'
      summary: Get the active exchange rate based on source and target exchange rates
      tags:
        - currencies
  /api/v1/currencies/{isoCode}:
    get:
      operationId: CurrenciesController_findOne_v1
      parameters:
        - name: isoCode
          required: true
          in: path
          description: ISO Code
          schema:
            example: GBP
            type: string
      responses:
        '200':
          description: Currency details from ISO code
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/CurrencyEntity'
      summary: Get a currency details from ISO code
      tags:
        - currencies
  /api/v1/customers:
    get:
      operationId: CustomersController_getCustomers_v1
      parameters:
        - name: companyReg
          required: false
          in: query
          description: >-
            The company registration number (in the country where the customer
            is registered) of the customer to search for.
          schema:
            example: '06012345'
            type: string
        - name: partyUrn
          required: false
          in: query
          description: The unique UKEF ID of the customer to search for.
          schema:
            pattern: ^\\d{8}$
            example: '00302069'
            type: string
        - name: name
          required: false
          in: query
          description: >-
            The name of the customer to search for, allows partial matches, not
            case sensitive.
          schema:
            example: Mock name
            type: string
        - name: fallbackToLegacyData
          required: false
          in: query
          description: >-
            Determines if the search results will include legacy records. If
            this value is 'yes' then we search for a Salesforce Account first
            and if there are no results then we search in legacy data (from the
            Party DB).
          schema:
            default: 'yes'
            example: legacy-only
            type: string
            enum:
              - 'yes'
              - 'no'
              - legacy-only
      responses:
        '200':
          description: Customers matching search parameters
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/GetCustomersResponseItem'
        '404':
          description: Customer not found.
      summary: Get customers from Salesforce
      tags:
        - customers
    post:
      operationId: CustomersController_getOrCreateCustomer_v1
      parameters: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/DTFSCustomerDto'
      responses:
        '200':
          description: Customers matching search parameters
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/GetCustomersResponseItem'
        '201':
          description: Customer successfully created
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/GetCustomersResponseItem'
        '400':
          description: >-
            Failed to create a customer in Salesforce, as a duplicate record
            without a company registration number exists
        '401':
          description: Failed to get access token
      summary: Get a customer in Salesforce, or create one if it does not exist
      tags:
        - customers
  /api/v1/customers/dun-bradstreet:
    get:
      operationId: CustomersController_getDunAndBradstreetNumber_v1
      parameters:
        - name: companyRegistrationNumber
          required: true
          in: query
          description: Company Registration Number
          schema:
            minLength: 8
            maxLength: 10
            type: string
      responses:
        '200':
          description: DUNS number
          content:
            application/json:
              schema:
                type: string
        '404':
          description: Customer not found.
      summary: Get DUNS number for a Company Registration Number
      tags:
        - customers
  /api/v1/numbers:
    post:
      operationId: NumbersController_create_v1
      parameters: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: array
              items:
                $ref: '#/components/schemas/CreateUkefIdDto'
      responses:
        '201':
          description: ''
      summary: Create Number
      tags:
        - numbers
    get:
      operationId: NumbersController_findOne_v1
      parameters:
        - name: type
          required: true
          in: query
          description: >-
            Id of UKEF ID type. Common types are: 1 for Deal/Facility, 2 for
            Party, 8 for Covenant
          schema:
            example: 1
            type: number
        - name: ukefId
          required: true
          in: query
          description: |-
            UKEF ID to check. Examples: 
            - Facility/Deal/Covenant ID: 0020019715 
            - Party URN: 00300524
          schema:
            example: '00300524'
            type: string
      responses:
        '200':
          description: The found record
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/UkefId'
      summary: Get information about UKEF ID
      tags:
        - numbers
  /api/v2/dom/business-centre/{centreCode}:
    get:
      operationId: DomController_findBusinessCentre_v2
      parameters:
        - name: centreCode
          required: true
          in: path
          description: Unique business centre code
          schema:
            example: GH_ACC
            type: string
      responses:
        '200':
          description: A DOM business centre
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/FindOdsBusinessCentreOdsResponse'
        '400':
          description: Bad request
        '404':
          description: Business centre not found
        '500':
          description: Internal server error
      summary: Get a business centre from DOM
      tags:
        - dom
  /api/v2/dom/business-centre/{centreCode}/non-working-days:
    get:
      operationId: DomController_findBusinessCentreNonWorkingDays_v2
      parameters:
        - name: centreCode
          required: true
          in: path
          description: Unique business centre code
          schema:
            example: GH_ACC
            type: string
        - name: startDate
          required: false
          in: query
          description: >-
            Optional non-working day start date filter (inclusive) in YYYY-MM-DD
            format
          schema:
            example: '2026-01-01'
            type: string
        - name: endDate
          required: false
          in: query
          description: >-
            Optional non-working day end date filter (inclusive) in YYYY-MM-DD
            format
          schema:
            example: '2026-12-31'
            type: string
      responses:
        '200':
          description: A DOM business centre's non working days
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/FindOdsBusinessCentreOdsResponseNonWorkingDayMappedResponse'
        '400':
          description: Bad request
        '404':
          description: Business centre not found
        '500':
          description: Internal server error
      summary: Get a business centre's non working days from DOM
      tags:
        - dom
  /api/v2/dom/business-centres:
    get:
      operationId: DomController_getBusinessCentres_v2
      parameters: []
      responses:
        '200':
          description: DOM business centres
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/FindOdsBusinessCentreOdsResponse'
        '400':
          description: Bad request
        '500':
          description: Internal server error
      summary: Get business centres from DOM
      tags:
        - dom
  /api/v2/dom/business-centres/non-working-days:
    get:
      operationId: DomController_findMultipleBusinessCentresNonWorkingDays_v2
      parameters:
        - name: centreCodes
          required: true
          in: query
          description: Unique business centre codes - separated by commas
          schema:
            example: GH_ACC,AO_LAD
            type: string
        - name: startDate
          required: false
          in: query
          description: >-
            Optional non-working day start date filter (inclusive) in YYYY-MM-DD
            format
          schema:
            example: '2026-01-01'
            type: string
        - name: endDate
          required: false
          in: query
          description: >-
            Optional non-working day end date filter (inclusive) in YYYY-MM-DD
            format
          schema:
            example: '2026-12-31'
            type: string
      responses:
        '200':
          description: Multiple DOM business centre's non working days
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/FindMultipleOdsBusinessCentreOdsResponsesNonWorkingDaysResponse'
        '400':
          description: Bad request
        '404':
          description: Business centres non working days not found
        '500':
          description: Internal server error
      summary: Get multiple business centre's non working days from DOM
      tags:
        - dom
  /api/v2/dom/credit-risk-ratings:
    get:
      operationId: DomController_getCreditRiskRatings_v2
      parameters: []
      responses:
        '200':
          description: All credit risk ratings
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/FindCreditRiskRatingDto'
        '500':
          description: Internal server error
      summary: Get all credit risk ratings
      tags:
        - dom
  /api/v2/dom/interest-rate-tickers:
    get:
      operationId: DomController_getInterestRateTickers_v2
      parameters: []
      responses:
        '200':
          description: All interest rate tickers
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/GetDomInterestRateTickersResponseDto'
        '500':
          description: Internal server error
      summary: Get all interest rate tickers
      tags:
        - dom
  /api/v2/dom/currencies:
    get:
      operationId: DomController_getCurrencies_v2
      parameters: []
      responses:
        '200':
          description: All currencies
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/GetDomCurrencyResponseDto'
        '500':
          description: Internal server error
      summary: Get all currencies
      tags:
        - dom
  /api/v2/dom/interest-rate:
    get:
      operationId: DomController_getInterestRates_v2
      parameters:
        - name: rateCode
          required: true
          in: query
          description: The code of the interest rate ticker
          schema:
            example: EUR002
            type: string
        - name: startDate
          required: false
          in: query
          description: >-
            Optional start date (inclusive) to retrieve interest rates from. If
            omitted, only the rate for the end date is returned.
          schema:
            example: '2026-01-01'
            type: string
        - name: endDate
          required: true
          in: query
          description: The end date (inclusive) to retrieve interest rates until
          schema:
            example: '2026-12-31'
            type: string
      responses:
        '200':
          description: DOM interest rates
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/GetDomInterestRateResponseDto'
        '400':
          description: Bad request
        '500':
          description: Internal server error
      summary: Get interest rates for a ticker within a date range from DOM
      tags:
        - dom
  /api/v2/dom/compounding-index:
    get:
      operationId: DomController_getCompoundingIndices_v2
      parameters:
        - name: rateCode
          required: true
          in: query
          description: The code of the interest rate ticker
          schema:
            example: EUR002
            type: string
        - name: startDate
          required: false
          in: query
          description: >-
            Optional start date (inclusive) to retrieve interest rates from. If
            omitted, only the rate for the end date is returned.
          schema:
            example: '2026-01-01'
            type: string
        - name: endDate
          required: true
          in: query
          description: The end date (inclusive) to retrieve interest rates until
          schema:
            example: '2026-12-31'
            type: string
      responses:
        '200':
          description: DOM compounding index values
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/GetDomCompoundingIndexResponseDto'
        '400':
          description: Bad request
        '500':
          description: Internal server error
      summary: Get compounding index values for a ticker within a date range from DOM
      tags:
        - dom
  /api/v2/dom/product-configuration/{productType}:
    get:
      operationId: DomController_findProductConfiguration_v2
      parameters:
        - name: productType
          required: true
          in: path
          description: Unique product type
          schema:
            example: PRT001
            type: string
      responses:
        '200':
          description: DOM product configuration
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/GetDomProductConfigResponse'
        '404':
          description: Product configuration not found
        '500':
          description: Internal server error
      summary: Get a product configuration from DOM
      tags:
        - dom
  /api/v2/dom/product-configurations:
    get:
      operationId: DomController_getProductConfigurations_v2
      parameters: []
      responses:
        '200':
          description: DOM product configurations
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/GetDomProductConfigResponse'
        '500':
          description: Internal server error
      summary: Get all product configurations from DOM
      tags:
        - dom
  /api/v2/dom/product-configurations-by-type:
    get:
      operationId: DomController_findMultipleProductConfigurations_v2
      parameters:
        - name: productTypes
          required: true
          in: query
          description: Unique product types - separated by commas
          schema:
            example: PRT001,PRT002
            type: string
      responses:
        '200':
          description: Multiple DOM product configurations
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/FindMultipleProductConfigsResponse'
        '400':
          description: Bad request
        '404':
          description: Product configurations not found
        '500':
          description: Internal server error
      summary: Get multiple product configurations from DOM
      tags:
        - dom
  /api/v1/emails:
    post:
      operationId: EmailsController_postEmail_v1
      parameters:
        - name: govUkNotifyKey
          required: true
          in: header
          schema:
            type: string
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PostEmailsRequestDto'
      responses:
        '201':
          description: Returns information about email transaction.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PostEmailsResponseDto'
        '400':
          description: Bad request
        '401':
          description: Unauthorized
        '403':
          description: Forbidden
        '422':
          description: No GOV.UK Notify response
        '500':
          description: Internal server error
      summary: Send email using GOV.UK Notify service
      tags:
        - emails
  /api/v1/exposure-period:
    get:
      operationId: ExposurePeriodController_find_v1
      parameters:
        - name: startdate
          required: true
          in: query
          description: Guarantee commencement date for a facility
          schema:
            example: '2017-07-04'
            type: string
        - name: enddate
          required: true
          in: query
          description: Guarantee expiry date for a facility
          schema:
            example: '2018-07-04'
            type: string
        - name: productgroup
          required: true
          in: query
          description: 'Two products are accepted: EW and BS'
          schema:
            example: EW
            type: string
      responses:
        '200':
          description: Calculated exposure period
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ExposurePeriodDto'
      summary: Calculate exposure period in months
      tags:
        - exposure-period
  /api/v1/geospatial/addresses/postcode:
    get:
      operationId: GeospatialController_getAddressesByPostcode_v1
      parameters:
        - name: postcode
          required: true
          in: query
          description: Postcode to search for
          schema:
            minLength: 5
            maxLength: 8
            pattern: ^[A-Za-z]{1,2}[\\dRr][\\dA-Za-z]?\\s?\\d[ABD-HJLNP-UW-Zabd-hjlnp-uw-z]{2}$
            example: SW1A 2AQ
            type: string
      responses:
        '200':
          description: Returns simplified addresses that are ready to show to users.
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/GetAddressesResponseItem'
        '404':
          description: No addresses found
      summary: >-
        Get addresses from Ordnance Survey Delivery Point Address (DPA) system
        by postcode. Will accept a full valid postcode
      tags:
        - geospatial
  /api/v1/ready:
    get:
      operationId: HealthcheckController_check_v1
      parameters: []
      responses:
        '200':
          description: >-
            API micro-service health check performs dependent databases
            connection and memory heap check


            The Health Check is successful
          content:
            application/json:
              schema:
                type: object
                properties:
                  status:
                    type: string
                    enum:
                      - ok
                      - degraded
                    example: ok
                  info:
                    type: object
                    example:
                      database:
                        status: up
                        responseTime: 12
                    additionalProperties:
                      type: object
                      required:
                        - status
                      properties:
                        status:
                          type: string
                          enum:
                            - up
                            - degraded
                            - down
                        responseTime:
                          type: number
                          description: Time the health indicator took to respond, in ms
                      additionalProperties: true
                    nullable: true
                  error:
                    type: object
                    example: {}
                    additionalProperties:
                      type: object
                      required:
                        - status
                      properties:
                        status:
                          type: string
                          enum:
                            - up
                            - degraded
                            - down
                        responseTime:
                          type: number
                          description: Time the health indicator took to respond, in ms
                      additionalProperties: true
                    nullable: true
                  details:
                    type: object
                    example:
                      database:
                        status: up
                        responseTime: 12
                    additionalProperties:
                      type: object
                      required:
                        - status
                      properties:
                        status:
                          type: string
                          enum:
                            - up
                            - degraded
                            - down
                        responseTime:
                          type: number
                          description: Time the health indicator took to respond, in ms
                      additionalProperties: true
        '503':
          description: The Health Check is not successful
          content:
            application/json:
              schema:
                type: object
                properties:
                  status:
                    type: string
                    enum:
                      - error
                      - shutting_down
                    example: error
                  info:
                    type: object
                    example:
                      database:
                        status: up
                        responseTime: 12
                    additionalProperties:
                      type: object
                      required:
                        - status
                      properties:
                        status:
                          type: string
                          enum:
                            - up
                            - degraded
                            - down
                        responseTime:
                          type: number
                          description: Time the health indicator took to respond, in ms
                      additionalProperties: true
                    nullable: true
                  error:
                    type: object
                    example:
                      redis:
                        status: down
                        message: Could not connect
                        responseTime: 3005
                    additionalProperties:
                      type: object
                      required:
                        - status
                      properties:
                        status:
                          type: string
                          enum:
                            - up
                            - degraded
                            - down
                        responseTime:
                          type: number
                          description: Time the health indicator took to respond, in ms
                      additionalProperties: true
                    nullable: true
                  details:
                    type: object
                    example:
                      database:
                        status: up
                        responseTime: 12
                      redis:
                        status: down
                        message: Could not connect
                        responseTime: 3005
                    additionalProperties:
                      type: object
                      required:
                        - status
                      properties:
                        status:
                          type: string
                          enum:
                            - up
                            - degraded
                            - down
                        responseTime:
                          type: number
                          description: Time the health indicator took to respond, in ms
                      additionalProperties: true
      summary: ready
      tags:
        - healthcheck
  /api/v1/interest-rates:
    get:
      operationId: InterestRatesController_findAll_v1
      parameters: []
      responses:
        '200':
          description: Active Interest rates
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/InterestRatesEntity'
      summary: Get all interest rates
      tags:
        - interest-rates
  /api/v1/markets:
    get:
      operationId: MarketsController_findAll_v1
      parameters:
        - name: active
          required: false
          in: query
          description: >-
            Optional filtering by field "active". If parameter is not provided
            result will include active and not active markets
          schema:
            example: 'Y'
            type: string
            enum:
              - 'Y'
              - 'N'
        - name: search
          required: false
          in: query
          description: >-
            Optional filtering by fields "marketName" or "isoCode". Partial
            matches are allowed and search is not case sensitive
          schema:
            example: korea
            type: string
      responses:
        '200':
          description: All markets
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/MarketEntity'
      summary: Get all markets (AKA countries)
      tags:
        - markets
  /api/v2/ods/accrual-frequencies:
    get:
      operationId: OdsController_getAccrualFrequencies_v2
      parameters: []
      responses:
        '200':
          description: ODS accrual frequencies
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/GetAccrualFrequencyResponseDto'
        '500':
          description: Internal server error
      summary: Get accrual frequencies from ODS
      tags:
        - ods
  /api/v2/ods/accrual-frequency/{frequencyCode}:
    get:
      operationId: OdsController_findAccrualFrequency_v2
      parameters:
        - name: frequencyCode
          required: true
          in: path
          description: Unique accrual frequency code
          schema:
            example: FREQ12MON
            type: string
      responses:
        '200':
          description: ODS frequency
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/GetAccrualFrequencyResponseDto'
        '400':
          description: Bad request
        '404':
          description: Accrual frequency not found
        '500':
          description: Internal server error
      summary: Get an accrual frequency from ODS
      tags:
        - ods
  /api/v2/ods/accrual-schedules:
    get:
      operationId: OdsController_getAccrualSchedules_v2
      parameters: []
      responses:
        '200':
          description: ODS accrual schedules
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/GetAccrualScheduleResponseDto'
        '500':
          description: Internal server error
      summary: Get accrual schedules from ODS
      tags:
        - ods
  /api/v2/ods/accrual-schedule/{scheduleCode}:
    get:
      operationId: OdsController_findAccrualSchedule_v2
      parameters:
        - name: scheduleCode
          required: true
          in: path
          description: Unique accrual schedule code
          schema:
            example: CTL01
            type: string
      responses:
        '200':
          description: ODS accrual schedule
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/GetAccrualScheduleResponseDto'
        '400':
          description: Bad request
        '404':
          description: Accrual schedule not found
        '500':
          description: Internal server error
      summary: Get an accrual schedule from ODS
      tags:
        - ods
  /api/v2/ods/additional-rates:
    get:
      operationId: OdsController_getAdditionalRates_v2
      parameters: []
      responses:
        '200':
          description: ODS additional rates
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/GetAdditionalRateResponseDto'
        '500':
          description: Internal server error
      summary: Get additional rates from ODS
      tags:
        - ods
  /api/v2/ods/additional-rate/{rateCode}:
    get:
      operationId: OdsController_findAdditionalRate_v2
      parameters:
        - name: rateCode
          required: true
          in: path
          description: Unique additional rate code
          schema:
            example: ARTCAS
            type: string
      responses:
        '200':
          description: ODS additional rate
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/GetAdditionalRateResponseDto'
        '400':
          description: Bad request
        '404':
          description: Additional rate not found
        '500':
          description: Internal server error
      summary: Get an additional rate from ODS
      tags:
        - ods
  /api/v2/ods/base-rates:
    get:
      operationId: OdsController_getBaseRates_v2
      parameters: []
      responses:
        '200':
          description: ODS base rates
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/GetBaseRateResponseDto'
        '500':
          description: Internal server error
      summary: Get base rates from ODS
      tags:
        - ods
  /api/v2/ods/base-rate/{rateCode}:
    get:
      operationId: OdsController_findBaseRate_v2
      parameters:
        - name: rateCode
          required: true
          in: path
          description: Unique base rate code
          schema:
            example: BRTBANK
            type: string
      responses:
        '200':
          description: ODS base rate
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/GetBaseRateResponseDto'
        '400':
          description: Bad request
        '404':
          description: Base rate not found
        '500':
          description: Internal server error
      summary: Get a base rate from ODS
      tags:
        - ods
  /api/v2/ods/counterparty-roles:
    get:
      operationId: OdsController_getCounterpartyRoles_v2
      parameters: []
      responses:
        '200':
          description: ODS counterparty roles
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/GetCounterpartyRoleResponseDto'
        '500':
          description: Internal server error
      summary: Get counterparty roles from ODS
      tags:
        - ods
  /api/v2/ods/counterparty-role/{roleType}:
    get:
      operationId: OdsController_findCounterpartyRole_v2
      parameters:
        - name: roleType
          required: true
          in: path
          description: Unique counterparty role type
          schema:
            example: CRT001
            type: string
      responses:
        '200':
          description: ODS counterparty role
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/GetCounterpartyRoleResponseDto'
        '400':
          description: Bad request
        '404':
          description: Counterparty role not found
        '500':
          description: Internal server error
      summary: Get a counterparty role from ODS
      tags:
        - ods
  /api/v2/ods/customers/{urn}:
    get:
      operationId: OdsController_findCustomer_v2
      parameters:
        - name: urn
          required: true
          in: path
          description: Unique UKEF customer ID
          schema:
            pattern: ^\\d{8}$
            example: '00302069'
            type: string
      responses:
        '200':
          description: A customer matching the provided URN
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/GetOdsCustomerResponse'
        '400':
          description: Invalid parameters provided
        '404':
          description: Customer not found
        '500':
          description: Internal server error
      summary: Get a customer from ODS
      tags:
        - ods
  /api/v2/ods/deal/{id}:
    get:
      operationId: OdsController_findDeal_v2
      parameters:
        - name: id
          required: true
          in: path
          description: Unique UKEF deal ID
          schema:
            pattern: ^00\\d{8}$
            example: '0030000321'
            type: string
      responses:
        '200':
          description: A deal matching the provided deal ID
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/GetOdsDealResponse'
        '400':
          description: Invalid parameters provided
        '404':
          description: Deal not found
        '500':
          description: Internal server error
      summary: Get a deal from ODS
      tags:
        - ods
  /api/v2/ods/facility-categories:
    get:
      operationId: OdsController_getFacilityCategories_v2
      parameters: []
      responses:
        '200':
          description: ODS facility categories
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/GetFacilityCategoryResponseDto'
        '500':
          description: Internal server error
      summary: Get facility categories from ODS
      tags:
        - ods
  /api/v2/ods/facility-category/{categoryCode}:
    get:
      operationId: OdsController_findFacilityCategory_v2
      parameters:
        - name: categoryCode
          required: true
          in: path
          description: Unique facility category code
          schema:
            example: FCT006
            type: string
      responses:
        '200':
          description: A facility category matching the provided category code
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/GetFacilityCategoryResponseDto'
        '400':
          description: Invalid parameters provided
        '404':
          description: Facility category not found
        '500':
          description: Internal server error
      summary: Get a facility category from ODS
      tags:
        - ods
  /api/v2/ods/fee-types:
    get:
      operationId: OdsController_getFeeTypes_v2
      parameters: []
      responses:
        '200':
          description: ODS fee types
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/GetFeeTypeResponseDto'
        '500':
          description: Internal server error
      summary: Get fee types from ODS
      tags:
        - ods
  /api/v2/ods/fee-type/{feeTypeCode}:
    get:
      operationId: OdsController_findFeeType_v2
      parameters:
        - name: feeTypeCode
          required: true
          in: path
          description: Unique fee type code
          schema:
            example: CMF
            type: string
      responses:
        '200':
          description: A fee type matching the provided fee type code
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/GetFeeTypeResponseDto'
        '400':
          description: Invalid parameters provided
        '404':
          description: Fee type not found
        '500':
          description: Internal server error
      summary: Get a fee type from ODS
      tags:
        - ods
  /api/v2/ods/obligation-subtypes:
    get:
      operationId: OdsController_getObligationSubtypes_v2
      parameters: []
      responses:
        '200':
          description: ODS obligation subtypes
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/GetObligationSubtypeResponseDto'
        '500':
          description: Internal server error
      summary: Get obligation subtypes from ODS
      tags:
        - ods
  /api/v2/ods/obligation-subtypes/with-product-type-codes:
    get:
      operationId: OdsController_getObligationSubtypesWithProductCodes_v2
      parameters: []
      responses:
        '200':
          description: ODS obligation subtypes with product type codes
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/ObligationSubtypeWithProductTypeDto'
        '500':
          description: Internal server error
      summary: Get obligation subtypes with product type codes from ODS
      tags:
        - ods
  /api/v2/ods/obligation-subtype/{subtypeCode}:
    get:
      operationId: OdsController_findObligationSubtype_v2
      parameters:
        - name: subtypeCode
          required: true
          in: path
          description: Unique obligation subtype code
          schema:
            example: OST012
            type: string
      responses:
        '200':
          description: An obligation subtype matching the provided subtype code
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/GetObligationSubtypeResponseDto'
        '400':
          description: Invalid parameters provided
        '404':
          description: Obligation subtype not found
        '500':
          description: Internal server error
      summary: Get an obligation subtype from ODS
      tags:
        - ods
  /api/v2/ods/ukef-industries:
    get:
      operationId: OdsController_getUkefIndustries_v2
      parameters: []
      responses:
        '200':
          description: Mapped UKEF industries from ODS
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/GetIndustryResponseDto'
        '500':
          description: Internal server error
      summary: Get UKEF industries from ODS
      tags:
        - ods
  /api/v2/ods/ukef-industry-codes:
    get:
      operationId: OdsController_getUkefIndustryCodes_v2
      parameters: []
      responses:
        '200':
          description: UKEF industry codes from ODS
          content:
            application/json:
              schema:
                type: array
                items:
                  type: string
        '500':
          description: Internal server error
      summary: Get UKEF industry codes from ODS
      tags:
        - ods
  /api/v2/ods/ukef-industry-code/by-companies-house-industry-code/{companiesHouseIndustryCode}:
    get:
      operationId: OdsController_findUkefIndustryCode_v2
      parameters:
        - name: companiesHouseIndustryCode
          required: true
          in: path
          description: Unique Companies House industry code
          schema:
            example: '25920'
            type: string
      responses:
        '200':
          description: The UKEF industry code from ODS
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/GetSicCodeToUkefIndustryResponseDto'
        '400':
          description: Invalid parameters provided
        '404':
          description: UKEF industry not found
        '500':
          description: Internal server error
      summary: >-
        Get a UKEF industry code by Companies House industry code. Sourced from
        ODS
      tags:
        - ods
  /api/v2/ods/ukef-industry/{industryCode}:
    get:
      operationId: OdsController_findUkefIndustry_v2
      parameters:
        - name: industryCode
          required: true
          in: path
          description: Unique UKEF industry code
          schema:
            example: '1908'
            type: string
      responses:
        '200':
          description: Mapped UKEF industry code from ODS
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/GetIndustryResponseDto'
        '400':
          description: Invalid parameters provided
        '404':
          description: Industry not found
        '500':
          description: Internal server error
      summary: Get a UKEF industry from ODS
      tags:
        - ods
  /api/v1/premium/schedule:
    post:
      operationId: PremiumSchedulesController_create_v1
      parameters: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: array
              items:
                $ref: '#/components/schemas/CreatePremiumScheduleDto'
      responses:
        '201':
          description: ''
      summary: Create a premium schedule sequence (AKA Income exposure)
      tags:
        - premium-schedules
  /api/v1/premium/segments/{facilityId}:
    get:
      operationId: PremiumSchedulesController_find_v1
      parameters:
        - name: facilityId
          required: true
          in: path
          description: UKEF ID for Facility, but without 00 at beginning
          schema:
            example: '30000425'
            type: string
      responses:
        '200':
          description: ''
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/PremiumScheduleEntity'
      summary: >-
        Return previously generated premium schedule sequence/segments (AKA
        Income exposures)
      tags:
        - premium-schedules
  /api/v1/yield-rates:
    get:
      operationId: YieldRatesController_find_v1
      parameters:
        - name: searchDate
          required: false
          in: query
          description: Filter yield rates for specific date. Can go back to 2010-03-15
          schema:
            example: '2023-03-01'
            type: string
      responses:
        '200':
          description: Returned Yield rates
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/YieldRateEntity'
      summary: Get Yield rates. These are updated daily from bloomberg
      tags:
        - yield-rates
info:
  title: MDM API Specification
  description: MDM API documentation
  version: '1.0'
  contact: {}
tags: []
servers: []
components:
  securitySchemes:
    ApiKeyHeader:
      type: apiKey
      in: header
      name: x-api-key
  schemas:
    GetCompanyResponse:
      type: object
      properties: {}
    SectorIndustryEntity:
      type: object
      properties:
        ukefSectorId:
          type: number
          example: 1001
        ukefSectorName:
          type: string
          example: Agriculture, Forestry and Fishing
        internalNo:
          type: number
          example: null
          description: Currently all values are null
        ukefIndustryId:
          type: string
          example: '01140'
        ukefIndustryName:
          type: string
          example: Growing of rice
        acbsSectorId:
          type: string
          example: '03'
        acbsSectorName:
          type: string
          example: 'CIVIL: AGRICULTURE, HORTICULTURE & FISHERIES'
        acbsIndustryId:
          type: string
          example: '0301'
        acbsIndustryName:
          type: string
          example: AGRICULTURE, HORTICULTURE & FISHERIES
        created:
          format: date-time
          type: string
          example: '2010-03-15T16:20:16.870Z'
        updated:
          format: date-time
          type: string
          example: '2010-03-15T16:20:16.867Z'
        effectiveFrom:
          format: date-time
          type: string
          example: '2010-03-15T16:20:16.870Z'
        effectiveTo:
          format: date-time
          type: string
          example: '9999-12-31T00:00:00.000Z'
      required:
        - ukefSectorId
        - ukefSectorName
        - internalNo
        - ukefIndustryId
        - ukefIndustryName
        - acbsSectorId
        - acbsSectorName
        - acbsIndustryId
        - acbsIndustryName
        - created
        - updated
        - effectiveFrom
        - effectiveTo
    CurrencyEntity:
      type: object
      properties:
        id:
          type: number
          example: 221
        name:
          type: string
          example: EUROS
        isoCode:
          type: string
          example: EUR
          description: Currency ISO code
        created:
          format: date-time
          type: string
          example: '2017-03-06T16:20:17.000Z'
        updated:
          format: date-time
          type: string
          example: '2017-03-06T16:20:16.000Z'
        effectiveFrom:
          format: date-time
          type: string
          example: '2017-03-07T10:44:47.000Z'
        effectiveTo:
          format: date-time
          type: string
          example: '9999-12-31T00:00:00.000Z'
        acbsCode:
          type: string
          example: '9'
      required:
        - id
        - name
        - isoCode
        - created
        - updated
        - effectiveFrom
        - effectiveTo
        - acbsCode
    GetCurrencyExchangeDto:
      type: object
      properties:
        source:
          type: string
          example: GBP
          description: >-
            Source currency for exchange rate - Use ISO 3 alpha currency code
            standard. Only GBP and USD currencies are supported
        target:
          type: string
          example: AED
          description: >-
            Target currency for exchange rate - Use ISO 3 alpha currency code
            standard
        exchangeRateDate:
          type: string
          example: '2021-01-26'
          description: Retrieve the exchange rate for a specific date
      required:
        - source
        - target
    GetCustomersResponseItem:
      type: object
      properties:
        companyRegNo:
          type: string
          description: The Companies House registration number
          example: '06012345'
        creditClassificationDate:
          type: string
          description: Credit Classification Status Date (dd/mm/yyyy)
          example: 01/01/1970
        creditClassificationStatus:
          type: string
          description: Credit classification status
          example: Good
        customerType:
          type: string
          description: Customer type
          example: Association
          enum:
            - Association
            - Corporate Overseas
            - Corporate UK
            - ECA
            - Financial Institution Overseas
            - Financial Institution UK
            - Non Corporate Overseas
            - Non Corporate UK
            - Overseas Government Dept.
            - Overseas Public Body
            - UK Government Dept.
            - UK Public Body
        isLegacyRecord:
          type: boolean
          description: False for Salesforce account record, True for legacy Party DB record
          example: false
        name:
          type: string
          description: Customer company name
          example: Mock name
        partyUrn:
          type: string
          description: The unique UKEF ID of the customer
          example: '00302069'
        probabilityOfDefault:
          type: number
          description: Probability of default of the company
          example: 14.1
        riskEntity:
          type: string
          description: Risk entity
          example: Corporate
        sfId:
          type: string
          description: The unique Salesforce ID
          example: 000A000000a1BBbCDE
        subtype:
          type: string
          description: Customer company subtype
          example: Alternative Finance Provider
          enum:
            - Alternative Finance Provider
            - Bank
            - Broker
            - Chamber of Commerce
            - Consolidated Joint Venture
            - Cooperative
            - Corporate Syndicate
            - Foreign Corporate
            - Foreign Non Corporate
            - Incorporated Charity
            - Insurance Company
            - Limited
            - Limited Liability Partnership
            - Membership Organisation
            - N/A
            - Non Corporate Syndicate (where the Syndicate is a legal entity)
            - Non Incorporated Charity
            - Partnership
            - PLC
            - Professional
            - Sole Trader
            - Special Purpose
            - Trade Association
        type:
          type: string
          description: Customer company type
          example: Association
          enum:
            - Association
            - Corporate Overseas
            - Corporate UK
            - ECA
            - Financial Institution Overseas
            - Financial Institution UK
            - Non Corporate Overseas
            - Non Corporate UK
            - Overseas Government Dept.
            - Overseas Public Body
            - UK Government Dept.
            - UK Public Body
        ukEntity:
          type: string
          description: Whether the company is UK based or not
          example: 'Yes'
        ukefIndustryName:
          type: string
          description: UKEF industry identifier code
          example: AGRICULTURE, HORTICULTURE & FISHERIES
        ukefSectorName:
          type: string
          description: UKEF industry sector identifier code
          example: 'CIVIL: AGRICULTURE, HORTICULTURE & FISHERIES'
      required:
        - companyRegNo
        - creditClassificationDate
        - creditClassificationStatus
        - customerType
        - isLegacyRecord
        - name
        - partyUrn
        - probabilityOfDefault
        - riskEntity
        - sfId
        - subtype
        - type
        - ukEntity
        - ukefIndustryName
        - ukefSectorName
    DTFSCustomerDto:
      type: object
      properties:
        companyRegistrationNumber:
          type: string
          description: Company registration number
          example: '06012345'
        companyName:
          type: string
          description: Company name
          example: Mock name
        customerType:
          type: string
          description: Salesforce customer type
          example: CUSTOMER
        probabilityOfDefault:
          type: number
          description: Probability of default
          example: 14.1
        ukEntity:
          type: string
          description: UK entity
          example: 'Yes'
        ukefIndustryName:
          type: string
          description: UKEF industry identifier code
          example: AGRICULTURE, HORTICULTURE & FISHERIES
        ukefSectorName:
          type: string
          description: UKEF industry sector identifier code
          example: 'CIVIL: AGRICULTURE, HORTICULTURE & FISHERIES'
      required:
        - companyRegistrationNumber
        - companyName
        - customerType
        - probabilityOfDefault
        - ukEntity
        - ukefIndustryName
        - ukefSectorName
    CreateUkefIdDto:
      type: object
      properties:
        numberTypeId:
          type: number
          example: 1
        createdBy:
          type: string
          example: ECGD\\jsmith
          description: User if it is known
        requestingSystem:
          type: string
          example: NodeJs/App
      required:
        - numberTypeId
        - createdBy
        - requestingSystem
    UkefId:
      type: object
      properties:
        id:
          type: number
          example: 20057861
          description: Internal id
        maskedId:
          type: string
          example: '0030570680'
          description: UKEF ID
        type:
          type: number
          example: 1
        createdBy:
          type: string
          example: ECGD\\jsmith
          description: User if it is known
        createdDatetime:
          format: date-time
          type: string
          example: '2021-11-30T09:44:04.15Z'
          description: Created timestamp
        requestingSystem:
          type: string
          example: NodeJs/App
      required:
        - id
        - maskedId
        - type
        - createdBy
        - createdDatetime
        - requestingSystem
    FindOdsBusinessCentreOdsResponse:
      type: object
      properties:
        code:
          type: string
          description: Business centre code
          example: GH_ACC
        name:
          type: string
          description: Business centre name
          example: Accra
        description:
          type: string
          description: Business centre description
          example: Location
        isActive:
          type: boolean
          description: Business centre active flag
          example: true
      required:
        - code
        - name
        - description
        - isActive
    FindOdsBusinessCentreOdsResponseNonWorkingDayMappedResponse:
      type: object
      properties:
        code:
          type: string
          description: Business centre code
          example: GH_ACC
        name:
          type: string
          description: Non working day name
          example: Weekend
        date:
          type: string
          description: Non working day date
          example: '2025-07-05'
      required:
        - code
        - name
        - date
    FindMultipleOdsBusinessCentreOdsResponsesNonWorkingDaysResponse:
      type: object
      properties:
        rawDefinition:
          description: Multiple business centre's non working days
          allOf:
            - $ref: '#/components/schemas/FindOdsBusinessCentreOdsResponseNonWorkingDayMappedResponse'
      required:
        - rawDefinition
    FindCreditRiskRatingDto:
      type: object
      properties:
        id:
          type: string
          example: A++
          description: Credit risk rating ID
        description:
          type: string
          example: A++
          description: Credit risk rating description
        createdAt:
          type: string
          example: '2017-03-06T16:43:47.000Z'
          description: Credit risk rating created at
        updatedAt:
          type: string
          example: '2017-03-06T16:43:47.000Z'
          description: Credit risk rating updated at
        effectiveFrom:
          type: string
          example: '2017-03-06T10:44:47.000Z'
          description: Credit risk rating effective from
        effectiveTo:
          type: string
          example: 9999-03-0 216T16:20:17.000Z
          description: Credit risk rating effective to
      required:
        - id
        - description
        - createdAt
        - updatedAt
        - effectiveFrom
        - effectiveTo
    GetDomInterestRateTickersResponseDto:
      type: object
      properties:
        code:
          type: string
          description: The code of the interest rate ticker
          example: EUR001
        name:
          type: string
          description: The name of the interest rate ticker
          example: ESTR Overnight Daily Compounding (5-day lag)
        type:
          type: string
          description: The type of the interest rate ticker
          example: Compounding Rate
        frequencyCode:
          type: string
          description: The code of the interest rate frequency
          example: FREQEBD
        frequencyName:
          type: string
          description: The name of the interest rate frequency
          example: Every Business Day
        leadDays:
          type: number
          description: The number of lead days for the interest rate ticker
          example: 5
        currencyCode:
          type: string
          description: The code of the currency
          example: EUR
        active:
          type: boolean
          description: Whether the interest rate ticker is active
          example: true
      required:
        - code
        - name
        - type
        - frequencyCode
        - frequencyName
        - leadDays
        - currencyCode
        - active
    GetDomCurrencyResponseDto:
      type: object
      properties:
        code:
          type: string
          description: The code of the currency
          example: USD
        name:
          type: string
          description: The name of the currency
          example: United States Dollar
        decimalPlaces:
          type: number
          description: The number of decimal places for the currency
          example: 2
        calendarCode:
          type: string
          description: The code of the rate setting calendar, or null if not provided
          example: CCYUSD
          nullable: true
      required:
        - code
        - name
        - decimalPlaces
        - calendarCode
    GetDomInterestRateResponseDto:
      type: object
      properties:
        code:
          type: string
          description: The code of the interest rate ticker
          example: EUR002
        startDate:
          type: string
          description: The start date and time the interest rate is active from
          example: '2026-07-01T00:00:00'
        endDate:
          type: string
          description: The end date and time the interest rate is active until
          example: '2026-07-01T23:59:59'
        rate:
          type: number
          description: The interest rate
          example: 3.25
        adjustedRate:
          type: number
          description: >-
            The interest rate adjusted so that negative rates are floored at
            zero
          example: 3.25
      required:
        - code
        - startDate
        - endDate
        - rate
        - adjustedRate
    GetDomCompoundingIndexResponseDto:
      type: object
      properties:
        code:
          type: string
          description: The code of the interest rate ticker
          example: EUR001
        compoundingIndexValue:
          type: number
          description: The compounding index value for the interest rate
          example: 10000.5361111111
        daysActive:
          type: number
          description: The number of days for which the interest rate is active
          example: 1
        endDate:
          type: string
          description: The end date and time the interest rate is active until
          example: '2026-07-01T23:59:59'
        indexEffectiveDate:
          type: string
          description: The start date and time the compounding index is effective from
          example: '2026-07-01T00:00:00'
        rate:
          type: number
          description: The interest rate
          example: 3.25
        startDate:
          type: string
          description: The start date and time the interest rate is active from
          example: '2026-07-01T00:00:00'
      required:
        - code
        - compoundingIndexValue
        - daysActive
        - endDate
        - indexEffectiveDate
        - rate
        - startDate
    GetDomProductConfigConfigFees:
      type: object
      properties:
        creation:
          type: string
