{
  "name": "mdm-api",
  "version": "1.60.0",
  "private": true,
  "description": "Master Data Management API",
  "license": "MIT",
  "author": "UKEF",
  "scripts": {
    "api-test": "jest --selectProjects=API",
    "audit:fix": "npm audit --fix",
    "build": "nest build -p tsconfig.build.json",
    "housekeeping": "npm update --save && npm i && npm run type-check && npm run prettier:fix && npm run lint:fix && npm run validate:yml && npm run audit:fix && npm run spellcheck",
    "lint": "eslint . --ext .js,.ts",
    "lint:fix": "eslint . --ext .js,.ts --fix",
    "prettier": "prettier --no-error-on-unmatched-pattern --check **/*.{ts,js}",
    "prettier:fix": "prettier --write **/*.{ts,js}",
    "snapshot:update": "npm run unit-test -- -u && npm run api-test -- -u",
    "spellcheck": "cspell lint --gitignore --no-must-find-files --unique --no-progress --show-suggestions --color '**/*'",
    "start": "nest start",
    "start:debug": "nest start --debug --watch",
    "start:dev": "nest start --tsc --watch",
    "start:prod": "node dist/src/main",
    "type-check": "tsc --noEmit --pretty",
    "unit-test": "jest --selectProjects=Unit",
    "unit-test-dev": "jest --verbose --config=jest.config.ts",
    "validate:all": "npm run lint:fix && npm run prettier:fix && npm run type-check && npm run validate:yml && npm run validate:md",
    "validate:md": "npx markdownlint-cli --config .markdownlint.json \"**/*.md\"",
    "validate:yml": "npx yaml-lint **/*.yml --ignore=**/node_modules"
  },
  "lint-staged": {
    "**/package.json": "sort-package-json",
    "**/*.{js,ts}": [
      "npm run lint:fix",
      "npm run prettier:fix"
    ],
    "**/*.md": [
      "prettier --write",
      "npx markdownlint-cli --config .markdownlint.json"
    ],
    "**/*.yml": [
      "npx yaml-lint --ignore=**/node_modules"
    ],
    "**/*": [
      "cspell lint --gitignore --no-must-find-files --unique --no-progress --show-suggestions --color"
    ]
  },
  "dependencies": {
    "@nestjs/axios": "12.0.1",
    "@nestjs/common": "12.1.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.2",
    "@nestjs/passport": "12.0.0",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/terminus": "12.1.0",
    "@nestjs/typeorm": "12.0.2",
    "axios": "1.20.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "compression": "1.8.2",
    "date-fns": "4.4.0",
    "dotenv": "18.0.8",
    "express": "5.2.1",
    "express-basic-auth": "1.2.1",
    "lodash": "4.18.1",
    "mssql": "12.7.10",
    "nestjs-pino": "5.3.1",
    "notifications-node-client": "8.5.0",
    "passport": "0.7.0",
    "passport-headerapikey": "1.2.2",
    "pino-http": "11.0.0",
    "pino-pretty": "13.2.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ts-jest": "29.4.15",
    "tsconfig-paths": "4.2.0",
    "tslib": "2.8.1",
    "typeorm": "1.1.2",
    "typeorm-extension": "4.3.0",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "9.39.4",
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.6",
    "@nestjs/testing": "12.1.2",
    "@tsconfig/node21": "21.0.9",
    "@types/chance": "1.1.8",
    "@types/compression": "1.8.1",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/lodash": "4.17.25",
    "@types/node": "26.6.4",
    "@types/supertest": "7.2.1",
    "@typescript-eslint/eslint-plugin": "8.59.2",
    "@typescript-eslint/parser": "8.59.2",
    "chance": "1.1.13",
    "cspell": "10.3.6",
    "eslint": "9.39.4",
    "eslint-config-prettier": "9.1.2",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-import-x": "4.16.2",
    "eslint-plugin-jest": "29.16.6",
    "eslint-plugin-no-relative-import-paths": "1.6.1",
    "eslint-plugin-prettier": "5.5.5",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "jest-when": "4.0.3",
    "lint-staged": "17.6.0",
    "markdownlint-cli": "0.49.1",
    "nock": "15.0.5",
    "prettier": "3.9.9",
    "sort-package-json": "4.0.0",
    "source-map-support": "0.5.21",
    "supertest": "7.3.1",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "typescript-eslint": "8.71.0",
    "yaml-lint": "1.7.0"
  },
  "engines": {
    "node": ">=24.17.0",
    "npm": ">=11.3.0"
  }
}
